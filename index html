<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Economics Study Helper</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            color: white;
            margin-bottom: 30px;
        }

        h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        .subtitle {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .mode-selector {
            display: flex;
            gap: 15px;
            margin-bottom: 30px;
            justify-content: center;
        }

        button {
            padding: 12px 30px;
            font-size: 1em;
            border: none;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-weight: 600;
            background: white;
            color: #667eea;
        }

        button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
        }

        button.active {
            background: #667eea;
            color: white;
        }

        .main-content {
            background: white;
            border-radius: 12px;
            padding: 40px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            min-height: 400px;
            display: flex;
            flex-direction: column;
        }

        /* Flashcard Styles */
        .flashcard {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 12px;
            padding: 40px;
            text-align: center;
            cursor: pointer;
            min-height: 250px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            transition: transform 0.3s ease;
            margin-bottom: 20px;
        }

        .flashcard:hover {
            transform: scale(1.02);
        }

        .flashcard.flipped {
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
        }

        .flashcard-label {
            font-size: 0.9em;
            opacity: 0.7;
            margin-bottom: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .flashcard-content {
            font-size: 1.8em;
            font-weight: 600;
            word-break: break-word;
        }

        .flashcard-hint {
            font-size: 0.85em;
            margin-top: 20px;
            opacity: 0.8;
            font-style: italic;
        }

        /* Quiz Styles */
        .question-container {
            margin-bottom: 30px;
        }

        .question {
            font-size: 1.3em;
            font-weight: 600;
            margin-bottom: 20px;
            color: #333;
        }

        .options {
            display: flex;
            flex-direction: column;
            gap: 12px;
        }

        .option {
            padding: 15px 20px;
            border: 2px solid #ddd;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            background: #f9f9f9;
            font-size: 1em;
        }

        .option:hover {
            border-color: #667eea;
            background: #f0f3ff;
        }

        .option.selected {
            border-color: #667eea;
            background: #e8ecff;
        }

        .option.correct {
            border-color: #10b981;
            background: #d1fae5;
            color: #065f46;
        }

        .option.incorrect {
            border-color: #ef4444;
            background: #fee2e2;
            color: #7f1d1d;
        }

        /* Navigation & Controls */
        .controls {
            display: flex;
            gap: 15px;
            margin-top: 30px;
            justify-content: center;
        }

        button.control-btn {
            padding: 12px 25px;
            background: #667eea;
            color: white;
        }

        button.control-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .progress-bar {
            width: 100%;
            height: 8px;
            background: #e5e7eb;
            border-radius: 4px;
            margin-bottom: 20px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            background: linear-gradient(90deg, #667eea, #764ba2);
            transition: width 0.3s ease;
        }

        .stats {
            display: flex;
            gap: 20px;
            margin-bottom: 20px;
            justify-content: space-around;
            flex-wrap: wrap;
        }

        .stat {
            text-align: center;
        }

        .stat-number {
            font-size: 2em;
            font-weight: bold;
            color: #667eea;
        }

        .stat-label {
            color: #666;
            font-size: 0.9em;
        }

        .hidden {
            display: none;
        }

        .results-screen {
            text-align: center;
        }

        .results-screen h2 {
            font-size: 2em;
            margin-bottom: 20px;
            color: #333;
        }

        .score-circle {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            margin: 20px auto;
            font-size: 3em;
            font-weight: bold;
        }

        .score-label {
            margin-top: 20px;
            color: #666;
        }

        @media (max-width: 600px) {
            h1 {
                font-size: 1.8em;
            }

            .main-content {
                padding: 20px;
            }

            .flashcard {
                min-height: 200px;
                padding: 30px 20px;
            }

            .flashcard-content {
                font-size: 1.3em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>📚 Economics Study Helper</h1>
            <p class="subtitle">Master economic concepts with flashcards and quizzes</p>
        </header>

        <div class="mode-selector">
            <button class="mode-btn active" data-mode="flashcard">🎴 Flashcards</button>
            <button class="mode-btn" data-mode="quiz">❓ Quiz</button>
        </div>

        <div class="main-content">
            <!-- Flashcard Mode -->
            <div id="flashcard-mode" class="mode-content">
                <div class="progress-bar">
                    <div class="progress-fill" id="flashcard-progress"></div>
                </div>
                <div class="stats">
                    <div class="stat">
                        <div class="stat-number" id="current-card">1</div>
                        <div class="stat-label">Current Card</div>
                    </div>
                    <div class="stat">
                        <div class="stat-number" id="total-cards">0</div>
                        <div class="stat-label">Total Cards</div>
                    </div>
                </div>
                <div class="flashcard" id="flashcard">
                    <div class="flashcard-label" id="card-label">TERM</div>
                    <div class="flashcard-content" id="card-content">Click to start</div>
                    <div class="flashcard-hint">(Click to flip)</div>
                </div>
                <div class="controls">
                    <button class="control-btn" id="prev-btn" onclick="previousCard()">← Previous</button>
                    <button class="control-btn" id="shuffle-btn" onclick="shuffleCards()">🔀 Shuffle</button>
                    <button class="control-btn" id="next-btn" onclick="nextCard()">Next →</button>
                </div>
            </div>

            <!-- Quiz Mode -->
            <div id="quiz-mode" class="mode-content hidden">
                <div class="progress-bar">
                    <div class="progress-fill" id="quiz-progress"></div>
                </div>
                <div class="stats">
                    <div class="stat">
                        <div class="stat-number" id="quiz-question-num">1</div>
                        <div class="stat-label">Question</div>
                    </div>
                    <div class="stat">
                        <div class="stat-number" id="quiz-correct">0</div>
                        <div class="stat-label">Correct</div>
                    </div>
                </div>
                <div id="quiz-content">
                    <div class="question-container">
                        <div class="question" id="question-text"></div>
                        <div class="options" id="options"></div>
                    </div>
                </div>
                <div class="controls" id="quiz-controls">
                    <button class="control-btn" id="quiz-next-btn" onclick="nextQuestion()" disabled>Next Question →</button>
                </div>
                <div id="results-container" class="hidden"></div>
            </div>
        </div>
    </div>

    <script>
        // Data
        const studyData = [
            { term: "Demand (Efterfrågan)", definition: "The quantity of a good or service that consumers are willing and able to buy at various prices." },
            { term: "Supply (Utbud)", definition: "The quantity of a good or service that producers are willing and able to offer at various prices." },
            { term: "Market Price (Marknadspris)", definition: "The price at which quantity demanded equals quantity supplied; equilibrium price." },
            { term: "Consumer Surplus", definition: "The difference between what consumers are willing to pay and what they actually pay." },
            { term: "Producer Surplus", definition: "The difference between the price producers receive and their minimum willingness to sell." },
            { term: "Utility (Nytta)", definition: "The satisfaction or benefit a consumer receives from consuming a good or service." },
            { term: "Opportunity Cost (Alternativkostnad)", definition: "The value of the best alternative foregone when making a choice." },
            { term: "Indifference Curve (Indifferenskurva)", definition: "A curve showing all combinations of goods that provide equal utility to a consumer." },
            { term: "Budget Constraint", definition: "The line showing all combinations of goods a consumer can afford with their income." },
            { term: "Nash Equilibrium", definition: "A situation where no player can improve their outcome by unilaterally changing their strategy." },
            { term: "Pareto Efficiency (Pareto-effektivitet)", definition: "A state where no one can be made better off without making someone else worse off." },
            { term: "Gini Coefficient (Gini-koefficient)", definition: "A measure of income inequality in a population, ranging from 0 (perfect equality) to 1 (perfect inequality)." },
            { term: "Marginal Utility (Marginalnytta)", definition: "The additional satisfaction gained from consuming one more unit of a good." },
            { term: "Price Elasticity of Demand", definition: "A measure of how responsive quantity demanded is to changes in price." },
            { term: "Income Elasticity of Demand", definition: "A measure of how responsive quantity demanded is to changes in income." },
            { term: "Normal Good", definition: "A good where demand increases as consumer income increases." },
            { term: "Inferior Good", definition: "A good where demand decreases as consumer income increases." },
            { term: "Substitutes", definition: "Goods that can be used in place of each other; an increase in price of one increases demand for the other." },
            { term: "Complements", definition: "Goods that are typically consumed together; a price increase in one decreases demand for the other." },
            { term: "Market Equilibrium", definition: "The point where quantity supplied equals quantity demanded, and there is no pressure for price to change." },
            { term: "Deadweight Loss", definition: "The loss of economic efficiency when equilibrium is not achieved, resulting in reduced total surplus." },
            { term: "Price Ceiling", definition: "A legal maximum price that can be charged for a good; often creates shortages." },
            { term: "Price Floor", definition: "A legal minimum price that must be paid for a good; often creates surpluses." },
            { term: "Consumer Behavior", definition: "The study of how individuals make decisions about purchasing goods and services." },
            { term: "Rational Economic Agent", definition: "An individual who makes decisions aimed at maximizing their utility or profit." },
            { term: "Budget Allocation", definition: "How consumers distribute their income among different goods and services." },
            { term: "Labor Supply", definition: "The quantity of labor that workers are willing to offer at various wage rates." },
            { term: "Wage (Lön)", definition: "The payment received by workers for their labor services." },
            { term: "Working Hours (Arbetstimmar)", definition: "The time spent working, as opposed to leisure time." },
            { term: "Trade-off", definition: "A situation where gaining something requires giving up something else of value." },
            { term: "Allocation Problem", definition: "The challenge of distributing limited resources among competing uses." },
            { term: "Microeconomics (Mikroekonomi)", definition: "The study of individual markets, consumers, and firms." },
            { term: "Macroeconomics (Makroekonomi)", definition: "The study of entire economies, focusing on national income, employment, and growth." },
            { term: "Market Mechanism", definition: "The process by which prices and quantities are determined through supply and demand." },
            { term: "Optimization", definition: "Making the best possible choice given constraints and available information." }
        ];

        let currentCardIndex = 0;
        let currentQuestionIndex = 0;
        let quizCorrect = 0;
        let isCardFlipped = false;
        let cards = [...studyData];
        let quizQuestions = [];
        let userAnswers = [];

        // Initialize
        document.addEventListener('DOMContentLoaded', () => {
            initializeModes();
            displayCard();
            document.getElementById('total-cards').textContent = cards.length;
        });

        // Mode switching
        function initializeModes() {
            document.querySelectorAll('.mode-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    const mode = e.target.dataset.mode;
                    switchMode(mode);
                });
            });
        }

        function switchMode(mode) {
            // Update buttons
            document.querySelectorAll('.mode-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            document.querySelector(`[data-mode="${mode}"]`).classList.add('active');

            // Update content
            document.querySelectorAll('.mode-content').forEach(content => {
                content.classList.add('hidden');
            });
            document.getElementById(`${mode}-mode`).classList.remove('hidden');

            if (mode === 'quiz' && quizQuestions.length === 0) {
                initializeQuiz();
            }
        }

        // Flashcard Functions
        function displayCard() {
            if (cards.length === 0) return;

            const card = cards[currentCardIndex];
            const cardEl = document.getElementById('flashcard');
            const labelEl = document.getElementById('card-label');
            const contentEl = document.getElementById('card-content');
            const currentEl = document.getElementById('current-card');

            isCardFlipped = false;
            cardEl.classList.remove('flipped');
            labelEl.textContent = 'TERM';
            contentEl.textContent = card.term;
            currentEl.textContent = currentCardIndex + 1;

            updateFlashcardProgress();
        }

        function flipCard() {
            if (cards.length === 0) return;

            const card = cards[currentCardIndex];
            const cardEl = document.getElementById('flashcard');
            const labelEl = document.getElementById('card-label');
            const contentEl = document.getElementById('card-content');

            if (!isCardFlipped) {
                isCardFlipped = true;
                cardEl.classList.add('flipped');
                labelEl.textContent = 'DEFINITION';
                contentEl.textContent = card.definition;
            } else {
                isCardFlipped = false;
                cardEl.classList.remove('flipped');
                labelEl.textContent = 'TERM';
                contentEl.textContent = card.term;
            }
        }

        function nextCard() {
            if (currentCardIndex < cards.length - 1) {
                currentCardIndex++;
                displayCard();
            }
        }

        function previousCard() {
            if (currentCardIndex > 0) {
                currentCardIndex--;
                displayCard();
            }
        }

        function shuffleCards() {
            cards = [...cards].sort(() => Math.random() - 0.5);
            currentCardIndex = 0;
            displayCard();
        }

        function updateFlashcardProgress() {
            const progress = ((currentCardIndex + 1) / cards.length) * 100;
            document.getElementById('flashcard-progress').style.width = progress + '%';
        }

        // Add click to flip
        document.addEventListener('DOMContentLoaded', () => {
            const flashcard = document.getElementById('flashcard');
            if (flashcard) {
                flashcard.addEventListener('click', flipCard);
            }
        });

        // Quiz Functions
        function initializeQuiz() {
            quizQuestions = [...studyData].sort(() => Math.random() - 0.5);
            currentQuestionIndex = 0;
            quizCorrect = 0;
            userAnswers = [];
            displayQuestion();
        }

        function displayQuestion() {
            if (currentQuestionIndex >= quizQuestions.length) {
                showResults();
                return;
            }

            const question = quizQuestions[currentQuestionIndex];
            const allQuestions = quizQuestions;
            
            // Create options: correct answer + 3 random wrong answers
            const wrongAnswers = allQuestions
                .filter(q => q.definition !== question.definition)
                .sort(() => Math.random() - 0.5)
                .slice(0, 3)
                .map(q => q.definition);

            const options = [question.definition, ...wrongAnswers]
                .sort(() => Math.random() - 0.5);

            // Display question
            document.getElementById('question-text').textContent = `What does "${question.term}" mean?`;
            document.getElementById('quiz-question-num').textContent = currentQuestionIndex + 1;
            document.getElementById('quiz-correct').textContent = quizCorrect;

            // Display options
            const optionsEl = document.getElementById('options');
            optionsEl.innerHTML = '';
            options.forEach((option, index) => {
                const optionEl = document.createElement('div');
                optionEl.className = 'option';
                optionEl.textContent = option;
                optionEl.onclick = () => selectAnswer(option, question.definition, optionEl);
                optionsEl.appendChild(optionEl);
            });

            updateQuizProgress();
        }

        function selectAnswer(selected, correct, optionEl) {
            const optionsEl = document.getElementById('options');
            const isCorrect = selected === correct;

            // Mark answer
            document.querySelectorAll('.option').forEach(opt => {
                opt.style.pointerEvents = 'none';
            });

            optionEl.classList.add(isCorrect ? 'correct' : 'incorrect');

            if (selected === correct) {
                document.querySelectorAll('.option').forEach(opt => {
                    if (opt.textContent === correct) {
                        opt.classList.add('correct');
                    }
                });
            } else {
                document.querySelectorAll('.option').forEach(opt => {
                    if (opt.textContent === correct) {
                        opt.classList.add('correct');
                    }
                });
            }

            if (isCorrect) {
                quizCorrect++;
                document.getElementById('quiz-correct').textContent = quizCorrect;
            }

            userAnswers.push({ isCorrect });

            // Enable next button
            document.getElementById('quiz-next-btn').disabled = false;
        }

        function nextQuestion() {
            currentQuestionIndex++;
            document.getElementById('quiz-next-btn').disabled = true;
            displayQuestion();
        }

        function updateQuizProgress() {
            const progress = ((currentQuestionIndex) / quizQuestions.length) * 100;
            document.getElementById('quiz-progress').style.width = progress + '%';
        }

        function showResults() {
            const percentage = Math.round((quizCorrect / quizQuestions.length) * 100);
            const resultsHTML = `
                <div class="results-screen">
                    <h2>Quiz Complete! 🎉</h2>
                    <div class="score-circle">${percentage}%</div>
                    <div class="score-label">You got ${quizCorrect} out of ${quizQuestions.length} correct</div>
                    <div class="controls" style="margin-top: 30px;">
                        <button class="control-btn" onclick="retakeQuiz()">Retake Quiz</button>
                    </div>
                </div>
            `;
            document.getElementById('quiz-content').innerHTML = resultsHTML;
            document.getElementById('quiz-controls').style.display = 'none';
        }

        function retakeQuiz() {
            document.getElementById('quiz-controls').style.display = 'flex';
            document.getElementById('quiz-next-btn').disabled = true;
            document.getElementById('quiz-content').innerHTML = '<div class="question-container"><div class="question" id="question-text"></div><div class="options" id="options"></div></div>';
            initializeQuiz();
        }
    </script>
</body>
</html>
